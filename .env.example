# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=coloque-a-service-role-key-aqui

# Sessao / JWT (gere uma string aleatoria longa, ex: openssl rand -base64 48)
AUTH_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Opcional: duração da sessão de login, em horas (padrão: 8)
SESSION_DURATION_HORAS=8

# Usado apenas pelo script scripts/seed-admin.mjs
SEED_ADMIN_SENHA=tisalvador@26
